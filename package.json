{
  "name": "zonebench",
  "version": "0.1.0",
  "private": true,
  "description": "Squared Away item editor and community add-on library",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "serve": "node tools/serve.cjs",
    "build": "node tools/check.cjs && node tools/prepare-preview.cjs && vite build",
    "dev": "node tools/prepare-preview.cjs && vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "lzo1x": "1.0.1"
  }
}
